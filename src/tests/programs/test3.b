main() {
    auto i;
    i = 0;
    while (i <= 10) {
        /* print(i * i); */
        print(i);
        ++i;
        ++i;
        /* i = i + 2; */
    }

    auto j;
    j = 0;
    while (j <= 10) {
        /* print(j * j * j); */
        print(j);
        ++j;
        /* j = j + 1; */
    }

    auto k;
    k = 0;
    while (k <= 10) {
        break;
    }
}